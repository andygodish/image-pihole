# Local test deployment; choose production bindings only at cutover.
DNS_BIND_IP=127.0.0.1
DNS_PORT=1053
WEB_BIND_IP=127.0.0.1
WEB_PORT=8080
TZ=Etc/UTC
# Match your chosen external providers before cutover. Never point these at
# FreeIPA while FreeIPA forwards external queries back to Pi-hole.
PIHOLE_UPSTREAMS=1.1.1.1;9.9.9.9
FREEIPA_DOMAIN=home.arpa
FREEIPA_DNS_IP=192.168.1.125
